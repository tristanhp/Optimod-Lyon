@startuml sequence-ajout-demande
title Ajout d'une demande après calcul sans relancer le TSP
actor Utilisateur
participant MainView
participant EtatAjoutLivraison
participant MainController
participant Plan
participant ListeDeCommandes
participant ProgrammeLivraisons
Utilisateur -> MainView : choisir collecte puis livraison
MainView -> EtatAjoutLivraison : cliquerNoeud
EtatAjoutLivraison -> MainController : saisirDemande
MainController -> MainView : saisirDemande
MainView --> MainController : durées et livreur 1, ou annulation
EtatAjoutLivraison -> MainController : ajouterDemande(demande validée)
MainController -> MainView : choisirPositionInsertion(tournée)
MainView --> MainController : intervalle choisi, ou annulation sans mutation
MainController -> MainController : EtatCalculEnCours, attente
MainController -> Plan : insererDemande(tournée, demande, position)
note right : Exécuteur en arrière-plan.
Plan -> Plan : trois chemins A* entre voisins et nouveaux arrêts
Plan -> Plan : réutiliser les autres chemins, propager les horaires
alt insertion possible
  Plan --> MainController : tournée à la position choisie, plages conservées
  MainController -> MainController : exécuteur de l'interface, cache
  MainController -> ListeDeCommandes : executer(CommandeAjouterDemande)
  ListeDeCommandes -> ProgrammeLivraisons : ajouterDemande
  ProgrammeLivraisons -> MainView : notifierObservateurs
  MainController -> MainView : afficherTournee, signalerArretsHorsPlage
else position choisie impossible
  Plan --> MainController : IllegalStateException
  MainController -> MainView : conserver tournée, afficherErreurCalcul
end
@enduml
