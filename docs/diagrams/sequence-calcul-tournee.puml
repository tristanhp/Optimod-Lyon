@startuml sequence-calcul-tournee
title Calculer les tournées
autonumber
actor Utilisateur as U
boundary "vue : MainView" as V
control "controleur : MainController" as C
participant "etat : EtatProgrammeCharge" as E
entity "plan : Plan" as P
participant "tsp : TSP3" as T
entity "programme : ProgrammeLivraisons" as L
U -> V : Cliquer sur « Calculer »
V -> C : action enregistrée
C -> E : calculer(controleur)
E -> C : changerEtat(new EtatCalculEnCours())
note right of C : tous les boutons désactivés.\nRecalculer (EtatTourneeCalculee) passe d'abord\npar confirmerRecalcul() ; un refus ne change rien
E -> C : lancerCalcul()
C -> V : afficherAttente(true)
group Thread d'arrière-plan
  C -> P : calculerTournees(programme)
  loop pour chaque livreur
    P -> P : calculerPlusCourtsChemins(sommets)
    note right of P : A* entre chaque couple d'adresses du livreur\n(entrepôt, collectes, livraisons)
    alt Ordre déjà en mémoire pour ces sommets
      P -> P : ordresMemorises.get(sommets)
    else Premier calcul de ces sommets
      P -> T : chercherSolution(10 s / livreurs occupés, GrapheDepandance)
      note right of T : séparation et évaluation,\ncollecte avant livraison
      T --> P : ordre de passage
    end
    P -> P : calculerHeuresDePassage(...)
    note right of P : 15 km/h, durées sur place ;\nchaque arrêt garde son type et sa demande
    opt Ordre trouvé par le TSP et tournée obtenue
      P -> P : ordresMemorises.put(sommets, ordre)
    end
  end
  P --> C : une Tournee par livreur (ou IllegalStateException)
end
group Thread de l'interface
  C -> C : etat.finirCalcul(tournees, erreur)
  alt Tournées calculées
    C -> L : definirTournees(tournees)
    L -> V : mettreAJour(programme)
    V --> U : arrêts et heures de passage, par livreur
    C -> C : historique.memoriserTournees(tournees)
    C -> C : changerEtat(new EtatTourneeCalculee())
    note right of C : un retour après 13:00 n'est pas une erreur :\nla tournée est affichée, les arrêts en retard\nsont repérés par Arret.estApresHeureLimite()
  else Adresse inaccessible ou aucun ordre trouvé
    C -> C : retrouverEtatProgramme()
    note right of C : EtatProgrammeCharge sans tournées ;\nEtatTourneeCalculee si un recalcul échoue
    C -> V : afficherErreurCalcul(message)
    V --> U : alerte « Calcul de la tournée impossible »
  end
end
@enduml
