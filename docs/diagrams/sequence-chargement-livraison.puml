@startuml sequence-chargement-livraison
title Charger les demandes de livraison
autonumber
actor Utilisateur as U
boundary "vue : MainView" as V
control "controleur : MainController" as C
entity "livraison : Livraison" as L
entity "entrepot : Entrepot" as E
entity "demande : Demande" as D
note over V,C
Précondition : un plan est chargé.
definirActionImportLivraison(action) relie le bouton à importerLivraison(ecran).
end note
U -> V : Cliquer sur « Importer la Livraison »
V -> C : importerLivraison(ecran) [action enregistrée]
note right of C : Dans EtatInitial : ignoré (bouton désactivé).
C -> V : choisirFichierLivraison()
V -> V : choisirFichierXml(titre)
V -> U : Ouvrir le sélecteur XML
U --> V : Sélectionner un fichier / annuler
V --> C : Optional<File>
alt Annulation
  note over V,C : Plan, livraison et message précédents conservés
else Fichier sélectionné
  C -> L : new Livraison(cheminFichierXml)
  L -> L : creerLecteurXml().parse(fichier)
  L -> L : Livraison(documentXml)
  L -> L : Vérifier la racine et l'unique entrepôt
  L -> L : lireAttributObligatoire(depot, "heureDepart")
  L -> E : new Entrepot(identifiant, heureDepart)
  loop Balises livraison dans l'ordre XML
    L -> L : lireAttributObligatoire(element, nom)
    note right of L : Lire adresses et durées ; vérifier nombres et durées non négatives
    L -> D : new Demande(identifiantCollecte, identifiantLivraison, dureeCollecte, dureeLivraison)
    D --> L : Demande
  end
  L -> L : List.copyOf(demandesLues)
  alt Lecture réussie
    L --> C : Livraison construite
    note right of C : Mémoriser livraison ; conserver plan
    C -> V : afficherLivraisonChargee(livraison)
    V -> V : messageLivraison.setText("livraison chargée")
    V --> U : « livraison chargée » en bas de la fenêtre
  else Erreur de lecture
    L --> C : IOException / SAXException / IllegalArgumentException
    C -> V : afficherErreurXml(erreur.getMessage())
    V --> U : Alerte « Fichier XML invalide »
    note over V,C : Plan, livraison et message précédents conservés
  end
end
@enduml
